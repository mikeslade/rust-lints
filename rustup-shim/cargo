#!/usr/bin/env bash
set -euo pipefail

# Thin shim used to build the rustc_private cdylib with the exact nightly
# resolved by the Nix devshell. Mirrors the per-project shims the consuming
# repos already use, but keyed on RUST_LINTS_* env vars.

export RUSTC="${RUST_LINTS_RUSTC:?RUST_LINTS_RUSTC is not set}"
export RUSTDOC="${RUST_LINTS_RUSTDOC:?RUST_LINTS_RUSTDOC is not set}"
export RUSTUP_TOOLCHAIN="${RUST_LINTS_RUSTUP_TOOLCHAIN:-${RUSTUP_TOOLCHAIN:?RUSTUP_TOOLCHAIN is not set}}"

exec "${RUST_LINTS_CARGO:?RUST_LINTS_CARGO is not set}" "$@"
